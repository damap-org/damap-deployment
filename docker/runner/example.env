# Fill every value on the host; empty values deliberately prevent startup.

# id -u / id -g for the deployment account; stat -c '%g' /var/run/docker.sock
RUNNER_UID=
RUNNER_GID=
DOCKER_GID=

# Existing application's Compose project label (preserve it to reuse its volumes).
DEPLOY_PROJECT=

# Absolute existing directories, mounted at identical host/container paths.
DEPLOY_PATH=
RUNNER_STATE_DIR=
BACKUP_DIR=
